# Site URL used for canonical metadata, sitemap, robots, and Open Graph tags
NEXT_PUBLIC_SITE_URL=https://digitstudio.design

# Cloudflare Turnstile Public Site Key (Client-side, default test key passes automatically in dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Resend Email Delivery Credentials (Server-side)
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=inbox@your-domain.example
CONTACT_FROM_EMAIL=Digit Studio <hello@your-domain.example>

# Cloudflare Turnstile Secret Key (Server-side)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
