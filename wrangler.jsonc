{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "digit-studio-website",
  "compatibility_date": "2026-11-18",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding: must match the Worker "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "digit-studio-website"
    }
  ],
  "observability": {
    "enabled": true
  }
}